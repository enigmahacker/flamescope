{"copyright":{"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"MAY_INCLUDE_COPYRIGHT_MATERIAL","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19970020608,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"ae07784793d54a2e8c19a569b448624b","belongsToAuthors":false},"subjectCategories":["Inorganic, Organic and Physical Chemistry"],"exportControl":{"isExportControl":"NO","submissionId":19970020608,"ear":"NO","id":"5335cb3701c54e9d8e27d011c67b238f","category":[{"submissionExportControlId":"5335cb3701c54e9d8e27d011c67b238f","id":"3e0e461a2e2d4c509ecd4026930ec2f9","category":0}],"itar":"NO"},"distributionDate":"1997-07-15T04:00:00.0000000+00:00","otherReportNumbers":["NASA-CP-10194"],"fundingNumbers":[{"number":"NAS3-23901","submissionId":19970020608,"id":"80562e47e00f464a9da37c547fc677e2","type":"CONTRACT_GRANT"}],"title":"Solid Surface Combustion Experiment: Thick Fuel Results","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-17T15:17:00.0000000+00:00","authorAffiliations":[{"organizationId":"6d4abf58a00554faacdb40980567ec32","sequence":0,"submissionId":19970020608,"meta":{"author":{"name":"Robert A Altenkirch"},"organization":{"name":"Washington State University","location":"Pullman, United States"}},"id":"da70e43f171e46bf9d731a516f9676d8","userType":"OTHER"},{"organizationId":"1e1c68b592ce5edd91bc8937f114814c","sequence":1,"submissionId":19970020608,"meta":{"author":{"name":"Subrata Bhattacharjee"},"organization":{"name":"San Diego State University","location":"San Diego, United States"}},"id":"5849bb7ffdcc4cbe84f6d77f4e8d7e7a","userType":"OTHER"},{"organizationId":"1e1c68b592ce5edd91bc8937f114814c","sequence":2,"submissionId":19970020608,"meta":{"author":{"name":"Jeff West"},"organization":{"name":"San Diego State University","location":"San Diego, United States"}},"id":"93f41432801442618af49c2857bb741a","userType":"OTHER"},{"organizationId":"6d4abf58a00554faacdb40980567ec32","sequence":3,"submissionId":19970020608,"meta":{"author":{"name":"Lin Tang"},"organization":{"name":"Washington State University","location":"Pullman, United States"}},"id":"a0a4f16ce12a4270adf0b6ef3ded4d9f","userType":"OTHER"},{"organizationId":"25b061d860a74d37b5938b104d1099ce","sequence":4,"submissionId":19970020608,"meta":{"author":{"name":"Kurt Sacksteder"},"organization":{"name":"Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"2898ebb556044edd8eef78c3ed182ef9","userType":"OTHER"},{"sequence":5,"submissionId":19970020608,"meta":{"author":{"name":"Michael A Delichatsios"},"organization":{"name":"Factory Mutual Research","location":"Norwood, MA United States"}},"id":"f45815e7a0314c7c9825574eaa508704","userType":"OTHER"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"NASA_TECHNICAL_MANAGEMENT","modified":"2026-09-23T18:06:18.3116640+00:00","id":19970020608,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"97N21881"},"created":"2013-08-17T15:17:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The results of experiments for spread over polymethylmethacrylate, PMMA, samples in the microgravity environment of the Space Shuttle are described. The results are coupled with modelling in an effort to describe the physics of the spread process for thick fuels in a quiescent, microgravity environment and uncover differences between thin and thick fuels. A quenching phenomenon not present for thin fuels is delineated, namely the fact that for thick fuels the possibility exists that, absent an opposing flow of sufficient strength to press the flame close enough to the fuel surface to allow the heated layer in the solid to develop, the heated layer fails to become 'fully developed.' The result is that the flame slows, which in turn causes an increase in the relative radiative loss from the flame, leading eventually to extinction. This potential inability of a thick fuel to develop a steady spread rate is not present for a thin fuel because the heated layer is the fuel thickness, which reaches a uniform temperature across the thickness relatively rapidly.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":19970020608,"id":"641f594c8f6045f9bd450669e5c757c0"},"meetings":[{"country":"US","submissionId":19970020608,"endDate":"1997-05-21T04:00:00.0000000+00:00","sponsors":[{"organizationId":"e53641f275f15469a1b19a8980e09171","meta":{"organization":{"name":"National Aeronautics and Space Administration","location":"Washington, United States"}},"meetingId":"600df809034b4f56a4cd1322f53cd3ff","id":"95903d44ee6c461e8155c3ac840519b0"}],"name":"Fourth International Microgravity Combustion Workshop","location":"Cleveland, OH","id":"600df809034b4f56a4cd1322f53cd3ff","startDate":"1997-05-19T04:00:00.0000000+00:00"}],"publications":[{"submissionId":19970020608,"publisher":"National Aeronautics and Space Administration","id":"4c89ed445099466f82d87f325f068ecd","publicationName":"Fourth International Microgravity Combustion Workshop","publicationDate":"1997-05-01T04:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":19970020547,"type":"ANALYTIC_PRIMARY","title":"Fourth International Microgravity Combustion Workshop","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19970020608.pdf","type":"STI","links":{"original":"/api/citations/19970020608/downloads/19970020608.pdf","pdf":"/api/citations/19970020608/downloads/19970020608.pdf","fulltext":"/api/citations/19970020608/downloads/19970020608.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}