},"id":"27ef8c2ead1d49d2b1ac4efde23c18c6","userType":"OTHER"},{"organizationId":"1ecc761ac02b58c2893eaa876cb7b267","sequence":3,"submissionId":19950007798,"meta":{"author":{"name":"Ramachandra, Prashant A."},"organization":{"name":"Mississippi State University","location":"Starkville, United States"}},"id":"157b2e2a87e94380bcc97424f5bdf088","userType":"OTHER"},{"organizationId":"1ecc761ac02b58c2893eaa876cb7b267","sequence":4,"submissionId":19950007798,"meta":{"author":{"name":"Lin Tang"},"organization":{"name":"Mississippi State University","location":"Starkville, United States"}},"id":"e42dc4834d734b12b87fa541b185e523","userType":"OTHER"},{"organizationId":"1ecc761ac02b58c2893eaa876cb7b267","sequence":5,"submissionId":19950007798,"meta":{"author":{"name":"M Katherine Wolverton"},"organization":{"name":"Mississippi State University","location":"Starkville, United States"}},"id":"d549ed06eab14a1092baa6d9f68085b8","userType":"OTHER"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2026-04-21T18:01:13.2605610+00:00","id":19950007798,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"95N14212"},"created":"2013-09-06T23:08:00.0000000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"AA Experimental results from the five experiments indicate that flame spread rate increases with increasing ambient oxygen content and pressure. An experiment was conducted aboard STS-50/USML-1 in the solid Surface Combustion Experiment (SSCE) hardware for flame spread over a thin cellulosic fuel in a quiescent oxidizer of 35% oxygen/65% nitrogen at 1.0 atm. pressure in microgravity. The USML-1 test was the fourth of five planned experiments for thin fuels, one performed during each of five Space Shuttle Orbiter flights. Data that were gathered include gas- and solid-phase temperatures and motion picture flame images. Observations of the flame are described and compared to theoretical predictions from steady and unsteady models that include flame radiation from CO2 and H2O. Experimental results from the five esperiments indicate that flame spread rate increases with increasing ambient oxygen content and pressure. The brightness of the flame and the visible soot radiation also increase with increasing spread rate. Steady-state numerical predictions of temperature and spread rate and flame structure trends compare well with experimental results near the flame's leading edge while gradual flame evolution is captured through the unsteady model.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":19950007798,"id":"ffb9a92334fd451483ea413b61fc8060"},"publications":[{"submissionId":19950007798,"id":"0fcfbc6b1cd34dddad73b92d692f9a2d","publicationName":"NASA. Marshall Space Flight Center, Joint Launch + One Year Science Review of USML-1 and USMP-1 with the Microgravity Measurement Group","publicationDate":"1994-05-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":19950007793,"type":"ANALYTIC_PRIMARY","title":"Joint Launch + One Year Science Review of USML-1 and USMP-1 with the Microgravity Measurement Group","stiType":"CONFERENCE_PUBLICATION","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19950007798.pdf","type":"STI","links":{"original":"/api/citations/19950007798/downloads/19950007798.pdf","pdf":"/api/citations/19950007798/downloads/19950007798.pdf","fulltext":"/api/citations/19950007798/downloads/19950007798.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}